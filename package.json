{
  "name": "urban-archimate",
  "version": "0.1.0",
  "description": "ArchiMate diagram editor web component built on diagram-js. Based on archimate-js by Vincent Boulet (MIT).",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
