{
  "name": "urban-archimate",
  "version": "0.1.0",
  "description": "ArchiMate diagram editor web component built on diagram-js. Based on archimate-js by Vincent Boulet (MIT).",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gaelgael5/urban-archimate"
  },
  "keywords": [
    "archimate",
    "diagram",
    "modeler",
    "web-component",
    "diagram-js"
  ],
  "files": [
    "index.js",
    "assets",
    "dist",
    "lib"
  ],
  "sideEffects": [
    "*.css",
    "src/index.ts",
    "src/web-component/UrbanArchimateElement.ts"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "all": "npm run lint && npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "build:python": "node scripts/build-python-package.mjs",
    "build:site": "vite build --config site/vite.config.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "archimate-font": "file:./vendor/archimate-font",
    "css.escape": "^1.5.1",
    "diagram-js": "^15.30.1",
    "diagram-js-direct-editing": "^3.6.0",
    "hex-and-rgba": "^2.0.0",
    "ids": "^3.0.2",
    "inherits-browser": "^0.1.0",
    "js-yaml": "^5.5.0",
    "min-dash": "^5.1.0",
    "min-dom": "^5.3.0",
    "moddle": "^8.2.1",
    "moddle-xml": "^12.3.2",
    "object-refs": "^0.4.0",
    "tiny-svg": "^4.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@types/js-yaml": "^4.0.9",
    "@vitest/browser-playwright": "^5.1.2",
    "eslint": "^10.15.0",
    "globals": "^16.0.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.2"
  },
  "module": "dist/urban-archimate.js",
  "types": "dist/types/src/index.d.ts"
}
